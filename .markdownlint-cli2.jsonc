{
  "config": {
    "default": true,
    // Prose is wrapped by the reader's editor, not at a fixed width.
    "MD013": false,
    // The README opens with a centred logo block rather than a Markdown heading.
    "MD033": { "allowed_elements": ["p", "img", "a", "h1", "br"] },
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
