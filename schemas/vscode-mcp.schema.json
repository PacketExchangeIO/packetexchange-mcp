{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PacketExchangeIO/packetexchange-mcp/schemas/vscode-mcp.schema.json",
  "title": "VS Code mcp.json",
  "description": "The .vscode/mcp.json format, limited to a remote HTTP server whose API key is prompted for once and stored by VS Code.",
  "type": "object",
  "required": ["inputs", "servers"],
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "id", "description", "password"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "promptString" },
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "password": { "const": true }
        }
      }
    },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "url", "headers"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "http" },
          "url": { "const": "https://packetexchange.io/mcp/http" },
          "headers": {
            "type": "object",
            "required": ["Authorization"],
            "additionalProperties": false,
            "properties": {
              "Authorization": { "type": "string", "pattern": "^Bearer \\$\\{input:[A-Za-z0-9-]+\\}$" }
            }
          }
        }
      }
    }
  }
}
