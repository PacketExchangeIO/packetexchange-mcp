{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PacketExchangeIO/packetexchange-mcp/schemas/mcp-servers.schema.json",
  "title": "mcpServers client configuration",
  "description": "The mcpServers file format used by desktop clients and editors that launch MCP servers as local commands.",
  "type": "object",
  "required": ["mcpServers"],
  "additionalProperties": false,
  "properties": {
    "mcpServers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["command", "args"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "args": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "contains": { "const": "https://packetexchange.io/mcp/sse" }
          }
        }
      }
    }
  }
}
