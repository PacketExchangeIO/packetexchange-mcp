{
  "inputs": [
    {
      "type": "promptString",
      "id": "packetexchange-api-key",
      "description": "PacketExchange API key",
      "password": true
    }
  ],
  "servers": {
    "packetexchange": {
      "type": "http",
      "url": "https://packetexchange.io/mcp/http",
      "headers": {
        "Authorization": "Bearer ${input:packetexchange-api-key}"
      }
    }
  }
}
